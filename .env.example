# UPS Dashboard Environment Configuration

# API Configuration
# Set to 'true' to force demo mode regardless of other settings
VITE_FORCE_DEMO_MODE=false

# API Base URL for live mode
# Development: http://localhost:5000/api/v1
# Production: /api/v1 (relative to current domain)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Optional API Key (if required by backend)
VITE_API_KEY=

# Application Settings
VITE_APP_TITLE="UPS Dashboard"
VITE_APP_VERSION="1.0.0"

# Development Settings
VITE_ENABLE_DEVTOOLS=true
VITE_LOG_LEVEL=info